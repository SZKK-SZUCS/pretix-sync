{
  "name": "szkk-szucs/pretix-sync",
  "description": "WooCommerce ticket sales synced to pretix: attendee details, one QR pass per attendee, optional session registration, badge tickets and staff passes.",
  "type": "wordpress-plugin",
  "authors": [
    {
      "name": "MFÜI - Szurofka Márton"
    }
  ],
  "require": {
    "php": ">=7.4",
    "yahnis-elsts/plugin-update-checker": "^5.6"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.9",
    "wp-coding-standards/wpcs": "^3.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpstan/phpstan": "^1.11",
    "szepeviktor/phpstan-wordpress": "^1.3"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "stan": "phpstan analyse --memory-limit=1G",
    "stan:baseline": "phpstan analyse --memory-limit=1G --generate-baseline"
  }
}
